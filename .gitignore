# secrets
.env
*.key
kaggle.json

# data (large / redistributable-restricted)
data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep

# python
# note: the venv lives at D:\venvs\supplyai (outside the repo) to stay under
# the Windows 260-character path limit -- see README Setup.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# results
results/models/*
results/logs/*
results/junit.xml
!results/**/.gitkeep

# figures ARE committed -- they are report deliverables and small (~550 KB)
!results/figures/*.png

# Office lock files, written next to a document while it is open and deleted
# on close. Transient and machine-local; committing one would confuse anyone
# who cloned the repo while a document happened to be open here.
~$*

# tooling
.ruff_cache/
